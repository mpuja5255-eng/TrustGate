# ==============================================================================
# TRUSTGATE Environment Configuration (Example Template)
# Copy this file to .env and customize values for your deployment.
# NEVER commit sensitive API keys, secrets, or passwords to version control.
# ==============================================================================

# Application Settings
TRUSTGATE_APP_NAME="TRUSTGATE"
TRUSTGATE_APP_VERSION="1.0.0"
TRUSTGATE_MODE="simulation"  # Options: simulation | shadow | enforcement

# Server Configuration
TRUSTGATE_HOST="127.0.0.1"
TRUSTGATE_PORT="8000"
TRUSTGATE_API_URL="http://127.0.0.1:8000/api"

# Database Connection (Default uses local SQLite in data directory)
TRUSTGATE_DATABASE_URL="sqlite:///data/trustgate.db"
# Example PostgreSQL for production:
# TRUSTGATE_DATABASE_URL="postgresql://user:password@localhost:5432/trustgate"

# Machine Learning / Isolation Forest Parameters
TRUSTGATE_ANOMALY_THRESHOLD="0.65"
TRUSTGATE_MODEL_VERSION="iforest-v1.0"
TRUSTGATE_CONTAMINATION="0.05"

# Security & CORS
TRUSTGATE_CORS_ORIGINS="*"
TRUSTGATE_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
